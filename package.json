{
  "name": "harfouz",
  "version": "0.1.0",
  "description": "Parametric Arabic typography playground: shape Arabic text correctly, then deform, color and animate it.",
  "keywords": [
    "arabic",
    "typography",
    "parametric",
    "variable",
    "harfbuzz",
    "three.js",
    "generative",
    "motion design",
    "kashida",
    "rtl"
  ],
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "harfbuzzjs": "^1.6.4",
    "mediabunny": "^1.65.0",
    "opentype.js": "^2.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
